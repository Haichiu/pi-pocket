{
    "$description": "The bench's own small system for the lint fixtures. String forms only, so any reader can load it.",
    "$extensions": { "com.pi-pocket": { "name": "Bench" } },
    "color": {
        "$type": "color",
        "gray": {
            "0": {
                "$value": "#ffffff",
                "$extensions": { "com.pi-pocket": { "tier": "primitive" } }
            },
            "50": { "$value": "#f6f7f9" },
            "100": { "$value": "#eceef2" },
            "200": { "$value": "#d5dae1" },
            "500": { "$value": "#5b6675" },
            "700": { "$value": "#343c48" },
            "900": { "$value": "#151a22" }
        },
        "blue": {
            "500": { "$value": "#1f5fd6" },
            "600": { "$value": "#194fb0" },
            "100": { "$value": "#dce7fb" }
        },
        "red": { "600": { "$value": "#b3261e" } },
        "amber": { "700": { "$value": "#8a5300" } },
        "green": { "700": { "$value": "#1b6b3a" } },
        "bg": {
            "default": { "$value": "{color.gray.50}" },
            "surface": { "$value": "{color.gray.0}" },
            "subtle": { "$value": "{color.gray.100}" }
        },
        "text": {
            "primary": {
                "$value": "{color.gray.900}",
                "$extensions": {
                    "com.pi-pocket": { "contrast": { "on": "{color.bg.default}", "min": 4.5 } }
                }
            },
            "muted": {
                "$value": "{color.gray.500}",
                "$extensions": {
                    "com.pi-pocket": { "contrast": { "on": "{color.bg.surface}", "min": 4.5 } }
                }
            },
            "inverse": {
                "$value": "{color.gray.0}",
                "$extensions": {
                    "com.pi-pocket": { "contrast": { "on": "{color.accent.default}", "min": 4.5 } }
                }
            }
        },
        "border": { "default": { "$value": "{color.gray.200}" } },
        "accent": {
            "default": { "$value": "{color.blue.500}" },
            "hover": { "$value": "{color.blue.600}" },
            "subtle": { "$value": "{color.blue.100}" }
        },
        "danger": { "default": { "$value": "{color.red.600}" } },
        "warning": { "default": { "$value": "{color.amber.700}" } },
        "success": { "default": { "$value": "{color.green.700}" } },
        "focus": { "ring": { "$value": "{color.blue.500}" } }
    },
    "space": {
        "$type": "dimension",
        "0": { "$value": "0px" },
        "1": { "$value": "4px" },
        "2": { "$value": "8px" },
        "3": { "$value": "12px" },
        "4": { "$value": "16px" },
        "6": { "$value": "24px" },
        "8": { "$value": "32px" },
        "12": { "$value": "48px" },
        "16": { "$value": "64px" }
    },
    "radius": {
        "$type": "dimension",
        "sm": { "$value": "4px" },
        "md": { "$value": "8px" },
        "lg": { "$value": "16px" },
        "full": { "$value": "9999px" }
    },
    "size": {
        "$type": "dimension",
        "tap": { "$value": "44px" },
        "container": { "$value": "640px" },
        "border": { "$value": "1px" },
        "ring": { "$value": "2px" },
        "card": { "$value": "240px" }
    },
    "font": {
        "family": {
            "$type": "fontFamily",
            "body": { "$value": ["system-ui", "-apple-system", "Segoe UI", "sans-serif"] },
            "mono": { "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "monospace"] }
        },
        "size": {
            "$type": "dimension",
            "xs": { "$value": "12px" },
            "sm": { "$value": "14px" },
            "md": { "$value": "16px" },
            "lg": { "$value": "20px" },
            "xl": { "$value": "24px" },
            "2xl": { "$value": "32px" }
        },
        "weight": {
            "$type": "fontWeight",
            "regular": { "$value": 400 },
            "medium": { "$value": 500 },
            "bold": { "$value": 700 }
        },
        "leading": {
            "$type": "number",
            "tight": { "$value": 1.2 },
            "normal": { "$value": 1.5 }
        }
    },
    "shadow": {
        "$type": "shadow",
        "sm": { "$value": "0 1px 2px rgb(21 26 34 / 0.12)" },
        "md": { "$value": "0 4px 12px rgb(21 26 34 / 0.16)" }
    },
    "motion": {
        "duration": {
            "$type": "duration",
            "fast": { "$value": "120ms" },
            "base": { "$value": "200ms" }
        },
        "ease": {
            "$type": "cubicBezier",
            "standard": { "$value": [0.2, 0, 0, 1] }
        }
    }
}
