{
    "name": "tailwind-v4",
    "description": "Brightside: Tailwind v4. A palette in @theme (oklch, hex, hsl), shadcn-style roles in :root and .dark through @theme inline, and spacing as a single base unit. Hex values were worked out by hand with an independent oklch conversion.",
    "colors": [
        "#ddf0ff",
        "#3581f6",
        "#2867e4",
        "#192f65",
        "#faf7f2",
        "#f3ede2",
        "#e6dcc8",
        "#6b7080",
        "#3a3f4b",
        "#14161c",
        "#d1432b",
        "#ae6c09",
        "#257e4a",
        "#ffffff",
        "#fff4d6"
    ],
    "darkColors": [
        "#0d1014",
        "#f0f2f5",
        "#14181f",
        "#3581f6",
        "#070b14",
        "#9da5b1",
        "#ffffff1f",
        "#ffffff26",
        "#f66d67",
        "#f0b135",
        "#55c975"
    ],
    "roles": {
        "bg": { "light": "#faf7f2", "dark": "#0d1014" },
        "surface": { "light": "#ffffff", "dark": "#14181f" },
        "text": { "light": "#14161c", "dark": "#f0f2f5" },
        "muted": { "light": "#6b7080", "dark": "#9da5b1" },
        "border": { "light": "#e6dcc8", "dark": "#ffffff1f" },
        "accent": { "light": "#2867e4", "dark": "#3581f6" },
        "danger": { "light": "#d1432b", "dark": "#f66d67" },
        "warning": { "light": "#ae6c09", "dark": "#f0b135" },
        "success": { "light": "#257e4a", "dark": "#55c975" }
    },
    "typeScale": [12, 14, 16, 18, 20, 24, 36, 60],
    "spacing": [4, 8, 12, 16, 24, 32, 48],
    "spacingBase": 4,
    "radii": [4, 8, 12, 16, 24],
    "shadows": [
        "0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)",
        "0 10px 30px -10px #14295f59"
    ],
    "fonts": ["Inter", "Fraunces", "Geist Mono"],
    "dark": { "present": true },
    "traps": [
        "--text-xs--line-height and the other line-height companions are not sizes",
        "primary-foreground and card-foreground are text-on-fill pairs, not roles",
        "--animate-fade-in and --ease-snappy are motion, not scales"
    ]
}
