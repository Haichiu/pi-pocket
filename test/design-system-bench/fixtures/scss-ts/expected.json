{
    "name": "scss-ts",
    "description": "Harbor: SCSS variables (palette, roles, scales, one value computed as $space-1 * 3) and a TypeScript theme object with light and dark colors (an object spread, numbers in arrays). Traps: two commented-out pinks, #{$prefix} interpolation, a breakpoints map, the Toast component.",
    "colors": [
        "#ffffff",
        "#f8f9fa",
        "#f1f3f5",
        "#e9ecef",
        "#dee2e6",
        "#868e96",
        "#495057",
        "#212529",
        "#1c4e80",
        "#163d66",
        "#1f9d8b",
        "#c92a2a",
        "#e67700",
        "#2b8a3e",
        "#0b7285"
    ],
    "darkColors": [
        "#101418",
        "#1a2027",
        "#e9ecef",
        "#9aa5b1",
        "#2d3640",
        "#6aa7e8",
        "#3bc9b5",
        "#ff8787",
        "#ffa94d",
        "#69db7c"
    ],
    "roles": {
        "bg": { "light": "#f8f9fa", "dark": "#101418" },
        "surface": { "light": "#ffffff", "dark": "#1a2027" },
        "text": { "light": "#212529", "dark": "#e9ecef" },
        "muted": { "light": "#868e96", "dark": "#9aa5b1" },
        "border": { "light": "#dee2e6", "dark": "#2d3640" },
        "accent": { "light": "#1c4e80", "dark": "#6aa7e8" },
        "danger": { "light": "#c92a2a", "dark": "#ff8787" },
        "warning": { "light": "#e67700", "dark": "#ffa94d" },
        "success": { "light": "#2b8a3e", "dark": "#69db7c" }
    },
    "typeScale": [12, 14, 16, 20, 28, 36],
    "spacing": [4, 8, 12, 16, 24, 32, 48],
    "radii": [3, 6, 12, 999],
    "shadows": ["0 1px 3px rgba(33, 37, 41, 0.12)", "0 8px 24px rgba(33, 37, 41, 0.18)"],
    "fonts": ["Source Sans 3", "Merriweather", "Fira Code"],
    "dark": { "present": true },
    "traps": [
        "// $legacy-pink: #ff69b4 and /* .legacy { color: #ff69b4 } */ in comments",
        ".#{$prefix}-hidden: interpolation, not a hex color",
        "$breakpoints is a map of widths, not a spacing scale",
        "space[0] = 0 is not a scale step"
    ]
}
