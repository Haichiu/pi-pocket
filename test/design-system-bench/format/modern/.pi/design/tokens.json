{
    "$description": "A modern system: 2025.10 object forms, composite types, references inside composites, three modes, a deprecated token.",
    "$extensions": { "com.pi-pocket": { "name": "Modern" } },
    "color": {
        "$type": "color",
        "blue": {
            "500": {
                "$value": {
                    "colorSpace": "srgb",
                    "components": [0.145, 0.388, 0.922],
                    "hex": "#2563eb"
                }
            },
            "600": { "$value": { "colorSpace": "oklch", "components": [0.55, 0.2, 262] } },
            "100": { "$value": { "colorSpace": "hsl", "components": [221, 83, 93] } }
        },
        "gray": {
            "0": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1] } },
            "100": { "$value": { "colorSpace": "srgb", "components": [0.96, 0.96, 0.97] } },
            "600": { "$value": { "colorSpace": "srgb", "components": [0.36, 0.38, 0.43] } },
            "900": { "$value": { "colorSpace": "srgb", "components": [0.07, 0.08, 0.11] } }
        },
        "red": { "600": { "$value": { "colorSpace": "srgb", "components": [0.8, 0.12, 0.12] } } },
        "scrim": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.5 } },
        "bg": {
            "base": { "$value": "{color.gray.100}" },
            "raised": { "$value": "{color.gray.0}" }
        },
        "fg": {
            "default": {
                "$value": "{color.gray.900}",
                "$extensions": {
                    "com.pi-pocket": { "contrast": { "on": "{color.bg.base}", "min": 7 } }
                }
            },
            "subtle": {
                "$value": "{color.gray.600}",
                "$extensions": {
                    "com.pi-pocket": { "contrast": { "on": "{color.bg.raised}", "min": 4.5 } }
                }
            }
        },
        "action": {
            "default": { "$value": "{color.blue.500}" },
            "strong": { "$value": "{color.blue.600}" }
        },
        "danger": { "$value": "{color.red.600}" },
        "old-accent": {
            "$value": "{color.blue.500}",
            "$deprecated": "Use color.action.default."
        }
    },
    "size": {
        "$type": "dimension",
        "2": { "$value": { "value": 0.5, "unit": "rem" } },
        "4": { "$value": { "value": 1, "unit": "rem" } },
        "6": { "$value": { "value": 24, "unit": "px" } }
    },
    "radius": {
        "$type": "dimension",
        "$root": { "$value": { "value": 6, "unit": "px" } },
        "lg": { "$value": { "value": 12, "unit": "px" } }
    },
    "font": {
        "family": {
            "sans": { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"] },
            "mono": { "$type": "fontFamily", "$value": ["JetBrains Mono", "monospace"] }
        },
        "weight": {
            "$type": "fontWeight",
            "regular": { "$value": 400 },
            "bold": { "$value": "bold" }
        }
    },
    "text": {
        "$type": "typography",
        "body": {
            "$value": {
                "fontFamily": "{font.family.sans}",
                "fontSize": { "value": 1, "unit": "rem" },
                "fontWeight": "{font.weight.regular}",
                "lineHeight": 1.5,
                "letterSpacing": { "value": 0, "unit": "px" }
            }
        }
    },
    "shadow": {
        "$type": "shadow",
        "card": {
            "$value": [
                {
                    "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.1 },
                    "offsetX": { "value": 0, "unit": "px" },
                    "offsetY": { "value": 1, "unit": "px" },
                    "blur": { "value": 3, "unit": "px" },
                    "spread": { "value": 0, "unit": "px" }
                },
                {
                    "color": "{color.scrim}",
                    "offsetX": { "value": 0, "unit": "px" },
                    "offsetY": { "value": 8, "unit": "px" },
                    "blur": { "value": 24, "unit": "px" },
                    "spread": { "value": -8, "unit": "px" }
                }
            ]
        }
    },
    "border": {
        "$type": "border",
        "default": {
            "$value": {
                "color": "{color.gray.600}",
                "width": { "value": 1, "unit": "px" },
                "style": "solid"
            }
        }
    },
    "motion": {
        "duration": {
            "$type": "duration",
            "fast": { "$value": { "value": 150, "unit": "ms" } },
            "slow": { "$value": { "value": 0.4, "unit": "s" } }
        },
        "easing": { "$type": "cubicBezier", "standard": { "$value": [0.2, 0, 0, 1] } },
        "fade": {
            "$type": "transition",
            "$value": {
                "duration": "{motion.duration.fast}",
                "delay": { "value": 0, "unit": "ms" },
                "timingFunction": "{motion.easing.standard}"
            }
        }
    },
    "gradient": {
        "$type": "gradient",
        "hero": {
            "$value": [
                { "color": "{color.blue.500}", "position": 0 },
                { "color": "{color.blue.600}", "position": 1 }
            ]
        }
    },
    "z": { "$type": "number", "modal": { "$value": 100 } }
}
