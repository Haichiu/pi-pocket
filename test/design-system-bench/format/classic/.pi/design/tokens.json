{
    "$description": "A classic system: string forms, three tiers, one dark mode.",
    "$extensions": { "com.pi-pocket": { "name": "Classic" } },
    "palette": {
        "$type": "color",
        "$extensions": { "com.pi-pocket": { "tier": "primitive" } },
        "slate": {
            "50": { "$value": "#f8fafc" },
            "200": { "$value": "#e2e8f0" },
            "500": { "$value": "#64748b" },
            "800": { "$value": "#1e293b" },
            "950": { "$value": "#0b1220" }
        },
        "indigo": { "500": { "$value": "#6366f1" }, "700": { "$value": "#4338ca" } },
        "rose": { "600": { "$value": "#e11d48" } },
        "amber": { "700": { "$value": "#b45309" } },
        "emerald": { "700": { "$value": "#047857" } },
        "white": { "$value": "#ffffff" }
    },
    "color": {
        "$type": "color",
        "bg": {
            "page": { "$value": "{palette.slate.50}" },
            "card": { "$value": "{palette.white}" }
        },
        "text": {
            "body": {
                "$value": "{palette.slate.950}",
                "$extensions": {
                    "com.pi-pocket": { "contrast": { "on": "{color.bg.page}", "min": 7 } }
                }
            },
            "quiet": {
                "$value": "{palette.slate.500}",
                "$description": "Secondary text.",
                "$extensions": {
                    "com.pi-pocket": { "contrast": { "on": "{color.bg.card}", "min": 4.5 } }
                }
            },
            "on-brand": {
                "$value": "{palette.white}",
                "$extensions": {
                    "com.pi-pocket": { "contrast": { "on": "{color.brand.default}", "min": 4.5 } }
                }
            }
        },
        "line": { "$value": "{palette.slate.200}" },
        "brand": {
            "default": { "$value": "{palette.indigo.700}" },
            "light": { "$value": "{palette.indigo.500}" }
        },
        "danger": { "$value": "{palette.rose.600}" },
        "warning": { "$value": "{palette.amber.700}" },
        "success": { "$value": "{palette.emerald.700}" }
    },
    "space": {
        "$type": "dimension",
        "xs": { "$value": "4px" },
        "sm": { "$value": "8px" },
        "md": { "$value": "16px" },
        "lg": { "$value": "24px" },
        "xl": { "$value": "40px" }
    },
    "radius": {
        "$type": "dimension",
        "sm": { "$value": "4px" },
        "md": { "$value": "10px" },
        "round": { "$value": "9999px" }
    },
    "font": {
        "body": { "$type": "fontFamily", "$value": "Inter, system-ui, sans-serif" },
        "code": { "$type": "fontFamily", "$value": "\"IBM Plex Mono\", monospace" },
        "size": {
            "$type": "dimension",
            "small": { "$value": "0.875rem" },
            "body": { "$value": "1rem" },
            "title": { "$value": "1.5rem" },
            "display": { "$value": "2.5rem" }
        },
        "weight": {
            "$type": "fontWeight",
            "normal": { "$value": 400 },
            "strong": { "$value": 700 }
        }
    },
    "shadow": {
        "$type": "shadow",
        "low": { "$value": "0 1px 2px rgb(15 23 42 / 0.1)" },
        "high": { "$value": "0 12px 32px rgb(15 23 42 / 0.2)" }
    },
    "motion": {
        "quick": { "$type": "duration", "$value": "100ms" },
        "slow": { "$type": "duration", "$value": "0.4s" },
        "curve": { "$type": "cubicBezier", "$value": [0.4, 0, 0.2, 1] }
    }
}
