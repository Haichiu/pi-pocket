      "$type": "dimension",
      "$value": "8px"
    },
    "padding": {
      "$type": "dimension",
      "$value": "12px"
    }
  },
  "menu": {
    "bg": {
      "$type": "color",
      "$value": "#252734"
    },
    "radius": {
      "$type": "dimension",
      "$value": "12px"
    },
    "shadow": {
      "$type": "shadow",
      "$value": [
        {
          "color": "#00000080",
          "offsetX": "0px",
          "offsetY": "24px",
          "blur": "60px",
          "spread": "-16px"
        },
        {
          "color": "#a9b1d62b",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "1px"
        }
      ]
    },
    "row-radius": {
      "$type": "dimension",
      "$value": "6px"
    },
    "row-height": {
      "$type": "dimension",
      "$value": "36px"
    },
    "row-hover": {
      "$type": "color",
      "$value": "#2b2d3b"
    },
    "row-selected": {
      "$type": "color",
      "$value": "#13203e"
    },
    "padding": {
      "$type": "dimension",
      "$value": "4px",
      "$description": "The padding of a menu around its rows."
    }
  },
  "step": {
    "mark-size": {
      "$type": "dimension",
      "$value": "19px"
    },
    "running": {
      "$type": "color",
      "$value": "#ad8ee6"
    },
    "done": {
      "$type": "color",
      "$value": "#9ece6a"
    },
    "failed": {
      "$type": "color",
      "$value": "#f7768e"
    },
    "waiting": {
      "$type": "color",
      "$value": "#e0af68"
    },
    "rule": {
      "$type": "color",
      "$value": "#a9b1d62b"
    }
  },
  "code-block": {
    "bg": {
      "$type": "color",
      "$value": "#13141c"
    },
    "radius": {
      "$type": "dimension",
      "$value": "8px"
    },
    "head-bg": {
      "$type": "color",
      "$value": "#2b2d3b"
    },
    "border": {
      "$type": "color",
      "$value": "#a9b1d61a"
    }
  },
  "layout": {
    "gap": {
      "in": {
        "$type": "dimension",
        "$value": "4px",
        "$description": "Between things inside one tile."
      },
      "out": {
        "$type": "dimension",
        "$value": "8px",
        "$description": "Between tiles."
      }
    }
  }
}
